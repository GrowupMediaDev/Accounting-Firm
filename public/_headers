# Cloudflare Pages Header-Regeln

# Gehashte Astro-Assets: unveraenderlich, lang cachen
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Bilder: laenger cachen
/images/*
  Cache-Control: public, max-age=2592000

# Sitemap-Stylesheet braucht XML-tauglichen Content-Type, sonst greift es nicht
/sitemap.xsl
  Content-Type: text/xsl; charset=utf-8
