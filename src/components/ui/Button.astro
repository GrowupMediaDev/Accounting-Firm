---
// Basis-Button (Figma 20:16 / 20:23). 50px hoch, Radius 6, Inter 16.
// Hover: ruhige Farbblende, Label bleibt stehen; beim Klick gibt er leicht nach.
interface Props {
  href?: string;
  variant?: 'dark' | 'light' | 'accent';
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}

const { href, variant = 'dark', type = 'button', class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
const label = await Astro.slots.render('default');
---
<Tag
  href={href}
  type={href ? undefined : type}
  class:list={['btn', `btn--${variant}`, className]}
  {...rest}
>
  <span class="btn__fill" aria-hidden="true"></span>
  <span class="btn__label"><Fragment set:html={label} /></span>
</Tag>

<style>
  .btn {
    --btn-bg: var(--color-ink);
    --btn-fg: var(--color-paper);
    --btn-fill: var(--color-accent);
    --btn-fg-hover: var(--color-paper);
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 3.125rem;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-btn);
    overflow: hidden;
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-size: 1rem;
    line-height: 1.625rem;
    white-space: nowrap;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .btn--light {
    --btn-bg: var(--color-paper);
    --btn-fg: var(--color-ink);
    --btn-fill: var(--color-ink);
  }
  .btn--accent {
    --btn-bg: var(--color-accent);
    --btn-fill: var(--color-accent-deep);
  }

  .btn {
    transition:
      color 0.45s var(--ease-out-quart),
      transform 0.45s var(--ease-out-quart);
  }
  .btn__fill {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--btn-fill);
    opacity: 0;
    transition: opacity 0.45s var(--ease-out-quart);
  }
  .btn__label { position: relative; display: block; }

  @media (hover: hover) {
    .btn:hover { color: var(--btn-fg-hover); }
    .btn:hover .btn__fill { opacity: 1; }
  }
  .btn:active { transform: scale(0.98); transition-duration: 0.15s; }
  .btn:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
</style>
