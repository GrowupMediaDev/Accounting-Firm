---
// Basis-Button (Figma 20:16 / 20:23). 50px hoch, Radius 6, Inter 16.
// Hover: Farbflaeche wischt von unten herein, Label rollt nach oben durch.
interface Props {
  href?: string;
  variant?: 'dark' | 'light' | 'accent';
  type?: 'button' | 'submit';
  class?: string;
  magnetic?: boolean;
  [key: string]: unknown;
}

const { href, variant = 'dark', type = 'button', class: className, magnetic = false, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
const label = await Astro.slots.render('default');
---
<Tag
  href={href}
  type={href ? undefined : type}
  class:list={['btn', `btn--${variant}`, className]}
  data-magnetic={magnetic ? '' : undefined}
  {...rest}
>
  <span class="btn__fill" aria-hidden="true"></span>
  <span class="btn__label">
    <span class="btn__text"><Fragment set:html={label} /></span>
    <span class="btn__text btn__text--clone" aria-hidden="true"><Fragment set:html={label} /></span>
  </span>
</Tag>

<style>
  .btn {
    --btn-bg: var(--color-ink);
    --btn-fg: var(--color-paper);
    --btn-fill: var(--color-accent);
    --btn-fg-hover: var(--color-paper);
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 50px;
    padding: 12px 24px;
    border-radius: var(--radius-btn);
    overflow: hidden;
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-size: 1rem;
    line-height: 26px;
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.5s var(--ease-out-expo);
    -webkit-tap-highlight-color: transparent;
  }
  .btn--light {
    --btn-bg: var(--color-paper);
    --btn-fg: var(--color-ink);
    --btn-fill: var(--color-ink);
  }
  .btn--accent {
    --btn-bg: var(--color-accent);
    --btn-fill: var(--color-ink);
  }

  .btn__fill {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--btn-fill);
    border-radius: 50% 50% 0 0 / 30% 30% 0 0;
    transform: translateY(101%);
    transition:
      transform 0.6s var(--ease-out-expo),
      border-radius 0.6s var(--ease-out-expo);
  }
  .btn__label {
    position: relative;
    display: block;
    overflow: hidden;
  }
  .btn__text {
    display: block;
    transition: transform 0.6s var(--ease-out-expo);
  }
  .btn__text--clone {
    position: absolute;
    inset: 0;
    transform: translateY(100%);
  }

  @media (hover: hover) {
    .btn:hover { color: var(--btn-fg-hover); }
    .btn:hover .btn__fill {
      transform: translateY(0);
      border-radius: 0;
    }
    .btn:hover .btn__text { transform: translateY(-100%); }
    .btn:hover .btn__text--clone { transform: translateY(0); }
  }
  .btn:active { transform: scale(0.98); }
</style>
