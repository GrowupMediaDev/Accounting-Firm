---
// Ein Link aus Button + Pfeil-Kachel (Figma 16:6737, Header-CTA).
// Beide Teile reagieren gemeinsam auf Hover.
import ArrowTile from './ArrowTile.astro';

interface Props {
  href: string;
  label: string;
  class?: string;
}
const { href, label, class: className } = Astro.props;
---
<a href={href} class:list={['cta-pair has-arrow group inline-flex items-center gap-2', className]}>
  <span class="cta-pair__btn">
    <span class="cta-pair__fill" aria-hidden="true"></span>
    <span class="cta-pair__label">
      <span class="cta-pair__text">{label}</span>
      <span class="cta-pair__text cta-pair__text--clone" aria-hidden="true">{label}</span>
    </span>
  </span>
  <ArrowTile as="span" />
</a>

<style>
  .cta-pair__btn {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    height: 50px;
    padding: 12px 24px;
    border-radius: var(--radius-btn);
    overflow: hidden;
    background: var(--color-ink);
    color: var(--color-paper);
    line-height: 26px;
    white-space: nowrap;
  }
  .cta-pair__fill {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-accent);
    border-radius: 50% 50% 0 0 / 30% 30% 0 0;
    transform: translateY(101%);
    transition: transform 0.6s var(--ease-out-expo), border-radius 0.6s var(--ease-out-expo);
  }
  .cta-pair__label { position: relative; display: block; overflow: hidden; }
  .cta-pair__text { display: block; transition: transform 0.6s var(--ease-out-expo); }
  .cta-pair__text--clone { position: absolute; inset: 0; transform: translateY(100%); }

  @media (hover: hover) {
    .cta-pair:hover .cta-pair__fill { transform: translateY(0); border-radius: 0; }
    .cta-pair:hover .cta-pair__text { transform: translateY(-100%); }
    .cta-pair:hover .cta-pair__text--clone { transform: translateY(0); }
    .cta-pair:hover :global(.arrow-tile) { background: var(--color-ink); }
  }
</style>
