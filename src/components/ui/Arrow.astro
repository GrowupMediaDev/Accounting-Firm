---
// Pfeil-Icon (Figma 16:6747) doppelt gestapelt: beim Hover fliegt der erste
// nach rechts oben raus, der zweite kommt von links unten nach.
import { Image } from 'astro:assets';
import arrow from '../../assets/icons/arrow-up-right.png';

interface Props {
  size?: number;
}
const { size = 24 } = Astro.props;
---
<span class="arrow relative block overflow-hidden" style={`width:${size / 16}rem;height:${size / 16}rem`} aria-hidden="true">
  <Image src={arrow} alt="" width={size} height={size} densities={[2, 3]} class="arrow-a absolute inset-0 size-full" />
  <Image src={arrow} alt="" width={size} height={size} densities={[2, 3]} class="arrow-b absolute inset-0 size-full" />
</span>

<style>
  .arrow :global(img) {
    transition: transform 0.6s var(--ease-out-expo);
  }
  .arrow :global(.arrow-b) {
    transform: translate(-110%, 110%);
  }
  :global(.has-arrow:hover) .arrow :global(.arrow-a),
  :global(.has-arrow:focus-visible) .arrow :global(.arrow-a) {
    transform: translate(110%, -110%);
  }
  :global(.has-arrow:hover) .arrow :global(.arrow-b),
  :global(.has-arrow:focus-visible) .arrow :global(.arrow-b) {
    transform: translate(0, 0);
  }
</style>
