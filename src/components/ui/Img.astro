---
// Responsives Inhaltsbild: AVIF/WebP-Varianten in mehreren Breiten.
// priority = Hero/LCP (eager + fetchpriority high), sonst lazy.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  widths?: number[];
  class?: string;
  pictureClass?: string;
  priority?: boolean;
  style?: string;
}

const { src, alt, sizes, widths, class: className, pictureClass, priority = false, style } = Astro.props;
const candidates = widths ?? [480, 768, 1080, 1440, 1920];
const usable = candidates.filter((w) => w <= src.width);
if (!usable.length) usable.push(src.width);
---
<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  widths={usable}
  sizes={sizes}
  quality={78}
  class={className}
  pictureAttributes={{ class: pictureClass }}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding={priority ? 'sync' : 'async'}
  style={style}
/>
