---
// Fixer Header (Figma 16:6710). Oben transparent in der Hero-Huelle,
// ab etwas Scrolltiefe eine schwebende Glas-Leiste, die beim Runterscrollen
// verschwindet und beim Hochscrollen zurueckkommt. Unter 1024px: Menue-Overlay.
import Logo from '../ui/Logo.astro';
import CtaPair from '../ui/CtaPair.astro';
import ArrowTile from '../ui/ArrowTile.astro';
import { mainNav, primaryCta, sectionHref, SECTION } from '../../config/nav';

const path = Astro.url.pathname;
const ctaHref = sectionHref(primaryCta.section, path);
---
<header class="site-header" data-header>
  <div class="site-header__bar">
    <Logo href={sectionHref(SECTION.start, path)} />

    <nav class="site-header__nav" aria-label="Hauptnavigation">
      <ul class="flex items-center gap-5">
        {mainNav.map((item) => (
          <li>
            <a href={sectionHref(item.section, path)} class="nav-link" data-nav-link={item.section}>
              <span class="nav-link__text" data-text={item.label}>{item.label}</span>
              <span class="nav-link__line" aria-hidden="true"></span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center justify-end gap-2 lg:w-[296px]">
      <CtaPair href={ctaHref} label={primaryCta.label} class="max-lg:hidden" />
      <div class="flex items-center gap-2 lg:hidden">
        <ArrowTile href={ctaHref} label={primaryCta.label} />
        <button
          type="button"
          class="menu-toggle"
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-menu-toggle
        >
          <span class="sr-only" data-menu-label>Menü öffnen</span>
          <span class="menu-toggle__line menu-toggle__line--a" aria-hidden="true"></span>
          <span class="menu-toggle__line menu-toggle__line--b" aria-hidden="true"></span>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu lg:hidden" data-menu hidden>
    <nav aria-label="Mobile Navigation" class="flex flex-1 flex-col justify-center">
      <ul class="flex flex-col gap-1">
        {mainNav.map((item, i) => (
          <li class="overflow-hidden">
            <a href={sectionHref(item.section, path)} class="mobile-menu__link" data-menu-item style={`--i:${i}`}>
              <span class="t-small mr-4 align-top text-accent tabular-nums">0{i + 1}</span>{item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="mobile-menu__foot" data-menu-item style={`--i:${mainNav.length}`}>
      <CtaPair href={ctaHref} label={primaryCta.label} />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    padding: 30px calc(var(--gutter) - 10px) 0;
    pointer-events: none;
    transition: transform 0.7s var(--ease-out-expo), padding 0.6s var(--ease-out-expo);
  }
  .site-header__bar {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: calc(var(--container-site) + 20px);
    height: var(--header-h);
    margin-inline: auto;
    padding: 0 10px;
    border-radius: var(--radius-card);
    border: 1px solid transparent;
    transition:
      background-color 0.5s var(--ease-out-expo),
      border-color 0.5s var(--ease-out-expo),
      box-shadow 0.5s var(--ease-out-expo),
      height 0.6s var(--ease-out-expo),
      padding 0.6s var(--ease-out-expo);
  }
  .site-header__nav { display: none; }
  @media (min-width: 1024px) {
    .site-header__nav { display: block; }
  }

  /* Gescrollt: schwebende Glas-Leiste */
  .site-header.is-scrolled { padding-top: 10px; }
  .site-header.is-scrolled .site-header__bar {
    height: 68px;
    padding: 0 9px 0 16px;
    background: color-mix(in srgb, var(--color-sky) 90%, transparent);
    border-color: rgb(255 255 255 / 0.6);
    box-shadow: 0 10px 40px -20px rgb(0 0 0 / 0.25);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    backdrop-filter: blur(16px) saturate(1.4);
  }
  .site-header.is-hidden:not(.is-open) { transform: translateY(-120%); }

  /* Nav-Link: Text rollt, Linie zeichnet sich von links */
  .nav-link {
    position: relative;
    display: block;
    height: 26px;
    overflow: hidden;
    line-height: 26px;
  }
  .nav-link__text {
    position: relative;
    display: block;
    transition: transform 0.6s var(--ease-out-expo);
  }
  .nav-link__text::after {
    content: attr(data-text);
    position: absolute;
    left: 0;
    top: 100%;
  }
  .nav-link__line {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.6s var(--ease-out-expo);
  }
  .nav-link[aria-current='true'] .nav-link__line {
    transform: scaleX(1);
    transform-origin: left;
  }
  @media (hover: hover) {
    .nav-link:hover .nav-link__text { transform: translateY(-100%); }
    .nav-link:hover .nav-link__line { transform: scaleX(1); transform-origin: left; }
  }

  /* Menue-Button */
  .menu-toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: var(--radius-btn);
    background: var(--color-ink);
    cursor: pointer;
  }
  .menu-toggle__line {
    position: absolute;
    width: 20px;
    height: 1.5px;
    background: var(--color-paper);
    transition: transform 0.5s var(--ease-out-expo);
  }
  .menu-toggle__line--a { transform: translateY(-4px); }
  .menu-toggle__line--b { transform: translateY(4px); }
  .is-open .menu-toggle__line--a { transform: rotate(45deg); }
  .is-open .menu-toggle__line--b { transform: rotate(-45deg); }

  /* Mobiles Overlay */
  .mobile-menu {
    pointer-events: auto;
    position: fixed;
    inset: 0;
    z-index: -1;
    display: flex;
    flex-direction: column;
    padding: calc(var(--header-h) + 60px) var(--gutter) 40px;
    background: var(--color-sky);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.8s var(--ease-in-out-expo);
  }
  .mobile-menu[hidden] { display: none; }
  .is-open .mobile-menu { clip-path: inset(0 0 0 0); }
  .mobile-menu__link {
    display: block;
    padding-block: 6px;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 10vw, 3.5rem);
    line-height: 1.1;
    transform: translateY(105%);
    transition: transform 0.9s var(--ease-out-expo);
  }
  .mobile-menu__foot {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s, transform 0.9s var(--ease-out-expo);
  }
  .is-open .mobile-menu__link,
  .is-open .mobile-menu__foot {
    opacity: 1;
    transform: translateY(0);
    transition-delay: calc(0.25s + var(--i) * 0.06s);
  }
  .is-open .site-header__bar { background: transparent; border-color: transparent; box-shadow: none; backdrop-filter: none; }

  @media (prefers-reduced-motion: reduce) {
    .site-header, .mobile-menu, .mobile-menu__link, .mobile-menu__foot { transition: none; }
  }
</style>

<script>
  type LenisLike = { stop(): void; start(): void };
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');

  if (header && toggle && menu && label) {
    // Scroll-Zustand: Glas-Leiste ab 40px, ausblenden beim Runterscrollen ab 400px.
    let lastY = window.scrollY;
    let ticking = false;
    const onScroll = () => {
      const y = window.scrollY;
      header.classList.toggle('is-scrolled', y > 40);
      const delta = y - lastY;
      if (Math.abs(delta) > 6) {
        header.classList.toggle('is-hidden', delta > 0 && y > 400);
        lastY = y;
      }
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(onScroll);
      }
    }, { passive: true });
    onScroll();

    // Mobiles Menue
    const lenis = () => (window as unknown as { lenis?: LenisLike }).lenis;
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Menü schließen' : 'Menü öffnen';
      if (open) {
        menu.hidden = false;
        requestAnimationFrame(() => requestAnimationFrame(() => header.classList.add('is-open')));
        lenis()?.stop();
        document.documentElement.style.overflow = 'hidden';
      } else {
        header.classList.remove('is-open');
        lenis()?.start();
        document.documentElement.style.overflow = '';
        menu.addEventListener('transitionend', () => {
          if (!header.classList.contains('is-open')) menu.hidden = true;
        }, { once: true });
      }
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });

    // Aktiver Menuepunkt nach sichtbarer Sektion
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
    const sections = links
      .map((a) => document.getElementById(a.dataset.navLink!))
      .filter((s): s is HTMLElement => Boolean(s));
    const setActive = (id: string) =>
      links.forEach((a) => a.setAttribute('aria-current', String(a.dataset.navLink === id)));
    if (sections.length) {
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && setActive(e.target.id)),
        { rootMargin: '-45% 0px -50% 0px' },
      );
      sections.forEach((s) => io.observe(s));
    } else {
      setActive(links[0]?.dataset.navLink ?? '');
    }
  }
</script>
