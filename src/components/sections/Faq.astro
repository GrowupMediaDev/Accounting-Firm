---
// Haeufige Fragen (Figma 34:4427): Akkordeon rechts, "Noch unsicher?"-Karte links.
// Dieselben Daten speisen das FAQPage-Schema (index.astro -> Schema).
import CtaPair from '../ui/CtaPair.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { SECTION } from '../../config/nav';
import { faqs } from '../../data/content';
import Plus from '../../assets/icons/plus.svg';
import Minus from '../../assets/icons/minus.svg';
---
<section class="container-site grid grid-cols-[minmax(0,1fr)] gap-12 pb-[50px] pt-[100px] lg:grid-cols-[minmax(0,500px)_minmax(0,1fr)] lg:gap-16">
  <div class="flex flex-col justify-between gap-12">
    <div>
      <Eyebrow>Häufige Fragen</Eyebrow>
      <h2 class="mt-2.5 font-display text-[clamp(2.25rem,1.8rem+1.5vw,3.125rem)] leading-tight text-balance" data-split>Antworten auf das, was Mandanten fragen</h2>
    </div>
    <div class="flex flex-col gap-[45px] rounded-[12px] bg-paper p-6" data-reveal="up">
      <div>
        <h3 class="font-display text-[30px] leading-[44px] text-[#0a0a0b]">Noch unsicher?</h3>
        <p class="mt-2.5 max-w-[363px] leading-6 tracking-[-0.02em] text-[#0a0a0b]/64">Das Erstgespräch ist unverbindlich und kostenfrei. Wir hören uns Ihre Situation an und sagen ehrlich, ob wir passen.</p>
      </div>
      <CtaPair href={`#${SECTION.termin}`} label="Erstgespräch vereinbaren" class="self-start" />
    </div>
  </div>

  <div class="flex flex-col gap-4" data-faq>
    {faqs.map((f, i) => (
      <div class="faq-item" data-reveal="up" data-open={i === 0 ? '' : undefined}>
        <h3>
          <button type="button" class="faq-item__q" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`faq-${i}`} id={`faq-q-${i}`}>
            <span>{f.q}</span>
            <span class="faq-item__icon" aria-hidden="true">
              <Plus width="20" height="20" class="faq-plus" />
              <Minus width="20" height="20" class="faq-minus" />
            </span>
          </button>
        </h3>
        <div class="faq-item__a" id={`faq-${i}`} role="region" aria-labelledby={`faq-q-${i}`}>
          <div class="overflow-hidden">
            <p class="px-5 pb-6 leading-6 tracking-[-0.02em] text-[#0a0a0b]/64">{f.a}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .faq-item {
    border-radius: 12px;
    background: var(--color-paper);
    transition: box-shadow 0.5s var(--ease-out-expo);
  }
  .faq-item:hover { box-shadow: 0 20px 40px -28px rgb(0 0 0 / 0.35); }
  .faq-item__q {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px;
    text-align: left;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.1rem + 0.45vw, 1.5rem);
    line-height: 1.17;
    color: #0a0a0b;
    hyphens: auto;
    cursor: pointer;
  }
  .faq-item[data-open] .faq-item__q { padding-top: 24px; }
  .faq-item__icon {
    position: relative;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: rgb(10 10 11 / 0.05);
    transition: background-color 0.4s var(--ease-out-expo), transform 0.6s var(--ease-out-expo);
  }
  .faq-item__icon :global(svg) {
    position: absolute;
    transition: opacity 0.3s, transform 0.6s var(--ease-out-expo);
  }
  .faq-item__q:hover .faq-item__icon { background: var(--color-sky); }
  .faq-minus { opacity: 0; transform: rotate(-90deg); }
  .faq-item[data-open] .faq-plus { opacity: 0; transform: rotate(90deg); }
  .faq-item[data-open] .faq-minus { opacity: 1; transform: rotate(0); }

  .faq-item__a {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.6s var(--ease-out-expo);
  }
  .faq-item[data-open] .faq-item__a { grid-template-rows: 1fr; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-faq] .faq-item').forEach((item, _, all) => {
    const btn = item.querySelector<HTMLButtonElement>('.faq-item__q')!;
    btn.addEventListener('click', () => {
      const open = !item.hasAttribute('data-open');
      // Immer nur eine Antwort offen, wie im Design.
      all.forEach((other) => {
        other.removeAttribute('data-open');
        other.querySelector('.faq-item__q')!.setAttribute('aria-expanded', 'false');
      });
      if (open) {
        item.setAttribute('data-open', '');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
