---
// Haeufige Fragen (Figma 34:4427): Fragen als Kontenblatt-Liste (wie Leistungen),
// links eine persoenliche Kontaktkarte.
// Dieselben Daten speisen das FAQPage-Schema (index.astro -> Schema).
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { SECTION } from '../../config/nav';
import { img } from '../../config/firm';
import { useI18n } from '../../i18n';
const { f: firm, fill, rich, t, ui, locale } = useI18n(Astro.url);

const c = firm.faq;
const faqs = c.items.map((f) => ({ q: fill(f.q), a: fill(f.a) }));
// Ansprechpartner fuer die Karte: Person aus dem Team (Name im Profil).
const member = firm.team.members.find((m) => m.name === c.contactPerson) ?? firm.team.members[0];
const contact = { ...member, image: img(member.image) };
---
<section class="faq container-site">
  <div class="faq__aside">
    <div>
      <Eyebrow>{c.eyebrow}</Eyebrow>
      <h2 class="t-h3 mt-2.5" data-split set:html={rich(c.heading)} />
    </div>

    <aside class="faq-contact" data-reveal="up" aria-label={t('personalContact')}>
      <div class="flex items-center gap-3.5">
        <Image src={contact.image} alt="" width={56} height={56} densities={[2, 3]} class="faq-contact__img" style={`object-position:${contact.focus}`} />
        <div>
          <p class="font-medium text-white">{contact.name}</p>
          <p class="text-[0.875rem] text-white/55">{contact.role}</p>
        </div>
      </div>
      <p class="faq-contact__title t-title">{fill(c.contactTitle)}</p>
      <p class="text-white/70">{fill(c.contactText)}</p>
      <Button href={`#${SECTION.termin}`} variant="accent" class="self-start">{c.contactCta}</Button>
    </aside>
  </div>

  <ul class="faq__list" data-faq>
    {faqs.map((f, i) => (
      <li class:list={['faq-item', i === 0 && 'is-open']}>
        <h3>
          <button type="button" class="faq-item__q" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`faq-${i}`} id={`faq-q-${i}`}>
            <span class="faq-item__idx">{String(i + 1).padStart(2, '0')}</span>
            <span class="faq-item__text">{f.q}</span>
            <span class="faq-item__toggle" aria-hidden="true"><span></span><span></span></span>
          </button>
        </h3>
        <div class="faq-item__a" id={`faq-${i}`} role="region" aria-labelledby={`faq-q-${i}`}>
          <div class="overflow-hidden">
            <p class="faq-item__answer">{f.a}</p>
          </div>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .faq {
    display: grid;
    gap: 3rem;
    padding-top: 6.25rem;
    padding-bottom: 3.125rem;
  }
  .faq__aside { display: flex; flex-direction: column; gap: 2.5rem; }
  @media (min-width: 1024px) {
    .faq { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 4rem; align-items: start; }
  }

  /* Kontaktkarte */
  .faq-contact {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 26rem;
    padding: 1.5rem;
    border-radius: var(--radius-card);
    background: var(--color-ink);
    line-height: 1.55;
  }
  /* Tablet: Karte ueber die volle Breite, Text links, Button rechts (statt halbe Breite + Leerraum). */
  @media (min-width: 640px) and (max-width: 1023px) {
    .faq-contact {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 2.5rem;
      row-gap: 0.75rem;
      max-width: none;
      padding: 1.75rem;
    }
    .faq-contact > :first-child { grid-column: 1 / -1; margin-bottom: 0.5rem; }
    .faq-contact__title { margin-top: 0; grid-column: 1; }
    .faq-contact > p:not(.faq-contact__title) { grid-column: 1; max-width: 34rem; }
    .faq-contact.faq-contact :global(.btn) { grid-column: 2; grid-row: 2 / span 2; align-self: end; margin-top: 0; }
  }
  .faq-contact__img { width: 3.5rem; height: 3.5rem; border-radius: 999px; object-fit: cover; }
  .faq-contact__title { margin-top: 0.75rem; color: var(--color-paper); }
  .faq-contact :global(.btn) { margin-top: 0.5rem; }

  /* Liste */
  .faq__list { border-top: 1px solid rgb(0 0 0 / 0.14); }
  .faq-item { border-bottom: 1px solid rgb(0 0 0 / 0.14); }
  .faq-item__q {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 1.5rem 0;
    text-align: left;
    cursor: pointer;
  }
  .faq-item__idx { font-size: 0.8125rem; letter-spacing: 0.06em; color: rgb(0 0 0 / 0.6); font-variant-numeric: tabular-nums; transition: color 0.4s; }
  .faq-item__text {
    font-size: clamp(1.125rem, 1rem + 0.45vw, 1.375rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
    transition: transform 0.7s var(--ease-out-expo);
  }
  .faq-item__toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 1px solid rgb(0 0 0 / 0.2);
    transition: background-color 0.4s, border-color 0.4s, color 0.4s, transform 0.6s var(--ease-out-expo);
  }
  .faq-item__toggle span {
    position: absolute;
    width: 0.8125rem;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.6s var(--ease-out-expo);
  }
  .faq-item__toggle span:last-child { transform: rotate(90deg); }
  @media (hover: hover) {
    .faq-item:not(.is-open) .faq-item__q:hover .faq-item__text { transform: translateX(0.5rem); }
    .faq-item__q:hover .faq-item__idx { color: var(--color-accent-ink); }
    .faq-item:not(.is-open) .faq-item__q:hover .faq-item__toggle { background: var(--color-ink); border-color: var(--color-ink); color: var(--color-paper); }
  }
  .faq-item.is-open .faq-item__idx { color: var(--color-accent-ink); }
  .faq-item.is-open .faq-item__toggle { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-paper); transform: rotate(180deg); }
  .faq-item.is-open .faq-item__toggle span:last-child { transform: rotate(0deg); }
  .faq-item__q:focus { outline: none; }
  .faq-item__q:focus-visible { outline: 2px solid var(--color-accent); outline-offset: -2px; border-radius: var(--radius-btn); }

  .faq-item__a {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.7s var(--ease-out-expo);
  }
  .faq-item.is-open .faq-item__a { grid-template-rows: 1fr; }
  .faq-item__answer {
    max-width: 38rem;
    padding: 0 3.5rem 1.75rem 3.5rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: rgb(0 0 0 / 0.68);
    opacity: 0;
    transform: translateY(0.5rem);
    transition: opacity 0.5s, transform 0.7s var(--ease-out-expo);
  }
  .faq-item.is-open .faq-item__answer { opacity: 1; transform: none; transition-delay: 0.1s; }
  @media (max-width: 639px) {
    .faq-item__answer { padding-right: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-item__a, .faq-item__answer, .faq-item__text, .faq-item__toggle { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-faq] .faq-item').forEach((item, _, all) => {
    const btn = item.querySelector<HTMLButtonElement>('.faq-item__q')!;
    btn.addEventListener('click', () => {
      const open = !item.classList.contains('is-open');
      // Immer nur eine Antwort offen.
      all.forEach((other) => {
        other.classList.remove('is-open');
        other.querySelector('.faq-item__q')!.setAttribute('aria-expanded', 'false');
      });
      if (open) {
        item.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
