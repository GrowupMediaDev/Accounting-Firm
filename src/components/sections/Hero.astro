---
// Hero (Figma 1:4): helle Huelle auf Schwarz, freigestellte Partner rechts,
// zwei schwebende Karten an der Unterkante. Intro-Timeline + Scroll-Parallaxe.
import { Image } from 'astro:assets';
import Img from '../ui/Img.astro';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import IconTile from '../ui/IconTile.astro';
import { SECTION } from '../../config/nav';
import { rating } from '../../data/content';
import partners from '../../assets/images/hero-partners.png';
import papierlos from '../../assets/images/papierlos.jpg';
import avatar1 from '../../assets/images/avatar-1.png';
import avatar2 from '../../assets/images/avatar-2.png';
import avatar3 from '../../assets/images/avatar-3.png';
import papierlosIcon from '../../assets/icons/papierlos.png';
import Star from '../../assets/icons/star.svg';

const avatars = [avatar1, avatar2, avatar3];
---
<section id={SECTION.start} class="hero" data-hero>
  <div class="hero__shell" data-hero-shell>
    <div class="container-site hero__inner">
      <div class="hero__copy">
        <Eyebrow reveal={false} class="hero-fade">Digitale Steuerberatung</Eyebrow>
        <h1 class="t-display mt-3" data-split="load" data-reveal-delay="0.35">Steuern ohne<br />Aktenordner</h1>
        <p class="hero-fade mt-6 max-w-[350px]">
          Wir betreuen Mittelstand und Selbstständige in Düsseldorf. Vollständig digital, mit festem Ansprechpartner und festem Monatshonorar.
        </p>
        <div class="hero-fade mt-[45px] flex flex-wrap gap-2.5">
          <Button href={`#${SECTION.termin}`} magnetic>Erstgespräch vereinbaren</Button>
          <Button href={`#${SECTION.leistungen}`} variant="light">Leistungen ansehen</Button>
        </div>
      </div>
    </div>

    <div class="hero__partners">
      <div class="size-full" data-hero-partners>
      <Img
        src={partners}
        alt="Die Partner Julia Vogt und Dr. Michael Hartmann"
        sizes="(min-width: 1024px) 70vw, 120vw"
        widths={[640, 960, 1280, 1600, 2000]}
        priority
        class="size-full object-contain object-bottom"
        pictureClass="block size-full"
      />
      </div>
    </div>
  </div>

  <div class="hero__cards container-site">
    <!-- Reaktionszeit (Figma 20:84) -->
    <article class="hero-card hero-card--light" data-hero-card data-float="0.6">
      <p class="t-small text-black">REAKTIONSZEIT</p>
      <p class="t-small text-black/80">Immer auf dem aktuellen Stand</p>
      <p class="mt-3 font-display text-[32px] leading-[42px]">24 Std.</p>
      <p>Antwort auf Ihre Anfragen, werktags.</p>
      <div class="mt-5 flex items-center gap-[18px]">
        <div class="flex items-center">
          {avatars.map((a, i) => (
            <Image src={a} alt="" width={36} height={36} densities={[2, 3]} class="hero-avatar" style={`z-index:${i}`} />
          ))}
          <span class="hero-avatar grid place-items-center bg-accent text-[12px] text-white" style="z-index:3">+25</span>
        </div>
        <div class="whitespace-nowrap">
          <div class="flex h-6 items-center gap-2">
            <span class="flex gap-0.5" aria-hidden="true">
              {Array.from({ length: 5 }).map(() => (
                <span class="grid size-5 place-items-center"><Star width="18" height="18" /></span>
              ))}
            </span>
            <span class="font-bold text-ink-soft">{rating.score}/{rating.max}</span>
          </div>
          <p class="text-ink-soft">{rating.clients} Mandanten betreut</p>
        </div>
      </div>
    </article>

    <!-- Papierlos arbeiten (Figma 22:310) -->
    <article class="hero-card hero-card--accent" data-hero-card data-float="1">
      <div class="flex items-center justify-between gap-2.5">
        <p class="leading-7 text-white">DIGITALE STEUERBERATUNG</p>
        <IconTile><Image src={papierlosIcon} alt="" width={24} height={24} densities={[2, 3]} /></IconTile>
      </div>
      <p class="mt-3 font-display text-[32px] leading-[42px] text-white">Papierlos arbeiten</p>
      <span class="mt-3 block h-0.5 w-[69px] bg-white" aria-hidden="true"></span>
      <div class="mt-3 h-[158px] overflow-hidden rounded-[var(--radius-media)]">
        <Img src={papierlos} alt="Handwerker in seiner Werkstatt" sizes="320px" widths={[320, 640, 960]} class="size-full object-cover" pictureClass="block size-full" />
      </div>
      <p class="mt-3 max-w-[300px] text-white">Belege hochladen, Auswertungen abrufen. Jederzeit von überall.</p>
    </article>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--color-ink);
    padding: 10px 10px 0;
  }
  .hero__shell {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-media);
    background: var(--color-sky);
    padding-top: calc(var(--header-h) + 130px);
  }
  .hero__inner {
    position: relative;
    z-index: 2;
    padding-inline: calc(var(--gutter) - 10px);
  }
  .hero__partners {
    position: relative;
    z-index: 1;
    width: 128%;
    margin: 24px -14% 0;
    aspect-ratio: 2835 / 2400;
    margin-bottom: -10%;
  }
  .hero__cards {
    position: relative;
    z-index: 3;
    display: grid;
    gap: 12px;
    margin-top: 12px;
    padding-inline: calc(var(--gutter) - 10px);
    padding-bottom: 60px;
  }
  .hero-card {
    border-radius: var(--radius-card);
    padding: 12px 24px 16px;
    will-change: transform;
  }
  .hero-card--light { background: var(--color-paper); }
  .hero-card--accent { background: var(--color-accent); padding: 24px; }
  .hero-avatar {
    width: 35px;
    height: 36px;
    border-radius: 999px;
    object-fit: cover;
    margin-left: -11px;
    position: relative;
  }
  .hero-avatar:first-child { margin-left: 0; }

  @media (min-width: 640px) {
    .hero__cards { grid-template-columns: 1fr 1fr; align-items: end; }
  }

  @media (min-width: 1024px) {
    .hero__shell {
      min-height: 832px;
      padding-top: calc(var(--header-h) + 140px);
    }
    .hero__copy { max-width: 590px; }
    .hero__partners {
      position: absolute;
      right: -3%;
      bottom: 0;
      width: clamp(600px, 70.8%, 1005px);
      margin: 0;
      transform: translateY(8.5%);
    }
    .hero__cards {
      position: absolute;
      inset: auto 0 7px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin: 0 auto;
      padding-inline: var(--gutter);
      padding-bottom: 0;
      pointer-events: none;
    }
    .hero__cards > * { pointer-events: auto; }
    .hero-card--light { width: 355px; margin-left: -2px; }
    .hero-card--accent { width: 357px; margin-bottom: 7px; margin-right: 1px; }
    .hero { padding-bottom: 139px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) [data-hero-card],
    :global(html.js) .hero-fade,
    :global(html.js) [data-hero-partners] {
      opacity: 0;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero && !reduce) {
    const shell = hero.querySelector('[data-hero-shell]');
    const partners = hero.querySelector('[data-hero-partners]');
    const cards = hero.querySelectorAll<HTMLElement>('[data-hero-card]');
    const fades = hero.querySelectorAll('.hero-fade');

    // Intro
    const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
    tl.from(shell, { scale: 0.965, borderRadius: 32, duration: 1.6, ease: 'expo.inOut' }, 0)
      .fromTo(partners, { opacity: 0, y: 90, scale: 1.04 }, { opacity: 1, y: 0, scale: 1, duration: 1.8 }, 0.45)
      .fromTo(fades, { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 1.2, stagger: 0.1, clearProps: 'transform' }, 0.55)
      .fromTo(
        cards,
        { opacity: 0, y: 90, rotate: (i: number) => (i ? 4 : -4) },
        { opacity: 1, y: 0, rotate: 0, duration: 1.5, stagger: 0.12 },
        0.9,
      );

    const mm = gsap.matchMedia();
    mm.add('(min-width: 1024px)', () => {
      // Scroll: Partner sinken leicht, Karten steigen unterschiedlich schnell.
      gsap.to(partners, {
        yPercent: 8,
        ease: 'none',
        scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true },
      });
      cards.forEach((card) => {
        const f = parseFloat(card.dataset.float || '1');
        gsap.to(card, {
          yPercent: -22 * f,
          ease: 'none',
          scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true },
        });
      });
      // Maus: Karten folgen dem Cursor minimal.
      if (window.matchMedia('(pointer: fine)').matches) {
        const movers = [...cards].map((c) => ({
          x: gsap.quickTo(c, 'x', { duration: 1.2, ease: 'power3.out' }),
          f: parseFloat(c.dataset.float || '1'),
        }));
        const onMove = (e: PointerEvent) => {
          const dx = e.clientX / window.innerWidth - 0.5;
          movers.forEach((m) => m.x(dx * 14 * m.f));
        };
        hero.addEventListener('pointermove', onMove);
        return () => hero.removeEventListener('pointermove', onMove);
      }
    });
  }
</script>
