---
// Team + Mandantenstimmen (Figma 27:2878): schwarzer, rundum gerundeter Block.
import Img from '../ui/Img.astro';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { SECTION } from '../../config/nav';
import { img } from '../../config/firm';
import { useI18n } from '../../i18n';
const { f: firm, fill, rich, t: tr, ui, locale } = useI18n(Astro.url);

const t = firm.team;
const ts = firm.testimonials;
const team = t.members.map((m) => ({ ...m, image: img(m.image) }));
const testimonials = ts.items.map((q) => ({ ...q, quote: fill(q.quote) }));
import Linkedin from '../../assets/icons/linkedin.svg';
import ArrowDown from '../../assets/icons/arrow-down-md.svg';

const initials = (name: string) => name.split(' ').map((p) => p[0]).slice(-2).join('');
---
<section id={SECTION.team} class="team">
  <div class="container-site">
    <!-- Team -->
    {t.show && (<>
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <Eyebrow>{t.eyebrow}</Eyebrow>
        <h2 class="t-h3 mt-3 max-w-[53.25rem] text-white" data-split set:html={rich(t.heading)} />
      </div>
      <!-- Fuehrt zum Erstgespraech; eine Team-Seite gibt es (noch) nicht. -->
      <div class="md:pb-[1.5625rem]" data-reveal="up"><Button href={`#${SECTION.termin}`} variant="light">{t.button}</Button></div>
    </div>

    {/* Portraets ohne Rahmen, einheitlich entsaettigt; mittleres versetzt, leicht unterschiedliche Parallaxe. */}
    <ul class:list={['team-grid', t.grayscale && 'team-grid--mono']}>
      {team.map((m, i) => (
        <li class="team-card" data-reveal="up">
          <div class="team-card__inner" data-parallax={[0.03, 0.07, 0.045][i % 3]}>
            <div class="team-card__media">
              <Img src={m.image} alt={`Porträt ${m.name}`} sizes="(min-width: 768px) 33vw, 100vw" widths={[400, 640, 900, 1200]} class="size-full object-cover" style={`object-position:${m.focus}`} pictureClass="block size-full" />
            </div>
            <div class="team-card__meta">
              <div>
                <p class="team-card__name">{m.name}</p>
                <p class="team-card__role">{m.role}</p>
              </div>
              {m.linkedin && (
                <a href={m.linkedin} class="team-card__social" aria-label={tr('onLinkedin', { name: m.name })}>
                  <Linkedin width="1.125rem" height="1.125rem" aria-hidden="true" />
                </a>
              )}
            </div>
          </div>
        </li>
      ))}
    </ul>
    </>)}

    <!-- Mandantenstimmen: typografisch, ohne Karte. Wechselt automatisch (Pause bei Hover/Fokus/ausserhalb). -->
    {ts.show && (
    <div class="tst" data-testimonials data-total={testimonials.length}>
      <div class="tst__aside">
        <div>
          <Eyebrow>{ts.eyebrow}</Eyebrow>
          <h2 class="t-h3 mt-2.5 text-white" data-split set:html={rich(ts.heading)} />
          <p class="mt-5 max-w-[30rem] text-[1.125rem] leading-[1.6] text-white/70" data-reveal="up">{fill(ts.lead)}</p>
        </div>
      </div>

      <div class="tst__main" data-reveal="up">
        <span class="tst__mark" aria-hidden="true">“</span>
        <div class="tst__slides" aria-live="polite">
          {testimonials.map((t, i) => (
            <figure class="tst__slide" data-slide={i} aria-hidden={i ? 'true' : 'false'}>
              <blockquote class="tst__quote">{t.quote}</blockquote>
              <figcaption class="tst__author">
                <span class="tst__initials" aria-hidden="true">{initials(t.name)}</span>
                <span>
                  <span class="block font-medium text-white">{t.name}</span>
                  <span class="block text-[0.875rem] text-white/55">{t.role}</span>
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
        <div class="tst__controls">
          <p class="tst__count" aria-hidden="true"><span data-current>01</span> / {String(testimonials.length).padStart(2, '0')}</p>
          <div class="tst__progress" aria-hidden="true">
            {testimonials.map((_, i) => <span><span data-seg={i}></span></span>)}
          </div>
          <div class="flex gap-2">
            <button type="button" class="t-nav" data-prev aria-label={tr('prevQuote')}><ArrowDown width="1.25rem" height="1.25rem" class="rotate-90" aria-hidden="true" /></button>
            <button type="button" class="t-nav" data-next aria-label={tr('nextQuote')}><ArrowDown width="1.25rem" height="1.25rem" class="-rotate-90" aria-hidden="true" /></button>
          </div>
        </div>
      </div>
    </div>
    )}
  </div>
</section>

<style>
  .team {
    --eyebrow-color: var(--color-accent);
    position: relative;
    margin-top: 0;
    padding-block: 6.25rem;
    border-radius: var(--radius-section);
    background: var(--color-ink);
  }
  .team-grid { display: grid; gap: 2.5rem; margin-top: 3.75rem; }
  @media (min-width: 768px) {
    .team-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.875rem; align-items: start; }
    .team-card:nth-child(3n + 2) { margin-top: 5rem; }
  }
  .team-card__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: #1a1a1a;
  }
  .team-card__media :global(img) {
    transition: transform 1.2s var(--ease-out-expo), filter 0.8s var(--ease-out-expo);
  }
  /* Optional (Profil team.grayscale): einheitlich schwarz-weiss, Farbe beim Hover. */
  .team-grid--mono .team-card__media :global(img) { filter: grayscale(1) contrast(1.05) brightness(0.95); }
  .team-card:hover .team-card__media :global(img),
  .team-card:focus-within .team-card__media :global(img) { filter: none; transform: scale(1.04); }
  @media (hover: none) {
    .team-card__media :global(img) { filter: none; }
  }
  .team-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(255 255 255 / 0.16);
  }
  .team-card__name { font-size: 1.25rem; font-weight: 500; letter-spacing: -0.02em; color: var(--color-paper); }
  .team-card__role { margin-top: 0.125rem; font-size: 0.9375rem; color: rgb(255 255 255 / 0.55); }
  .team-card__social {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.25);
    transition: background-color 0.4s var(--ease-out-expo), border-color 0.4s;
  }
  .team-card__social:hover { background: var(--color-accent); border-color: var(--color-accent); }

  .tst { display: grid; gap: 3.5rem; margin-top: 8.125rem; }
  /* Ohne Team-Block steht die Stimme oben in der Sektion. */
  .tst:first-child { margin-top: 0; }
  .tst__main { position: relative; display: flex; flex-direction: column; }
  /* Dekoratives Anfuehrungszeichen mit eigenem Raum ueber dem Zitat. */
  .tst__mark {
    display: block;
    height: 2.75rem;
    font-family: var(--font-display);
    font-size: 6rem;
    line-height: 0.9;
    color: var(--color-accent);
  }
  .tst__slides { display: grid; margin-top: 0.75rem; }
  .tst__slide {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
    transition: opacity 0.6s var(--ease-out-expo), transform 0.9s var(--ease-out-expo), visibility 0.9s;
  }
  .tst__slide[aria-hidden='true'] { opacity: 0; visibility: hidden; transform: translateY(1.25rem); }
  .tst__quote {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.75rem);
    line-height: 1.18;
    letter-spacing: -0.01em;
    color: var(--color-paper);
    text-wrap: pretty;
  }
  .tst__author { display: flex; align-items: center; gap: 0.875rem; padding-top: 1.25rem; border-top: 1px solid rgb(255 255 255 / 0.16); }
  .tst__initials {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.08);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    color: var(--color-paper);
  }
  .tst__controls { display: flex; align-items: center; gap: 1.25rem; margin-top: 2rem; }
  .tst__count { font-size: 0.875rem; color: rgb(255 255 255 / 0.6); font-variant-numeric: tabular-nums; }
  .tst__count span { color: var(--color-paper); }
  .tst__progress { flex: 1; display: grid; grid-template-columns: repeat(var(--n, 3), 1fr); gap: 0.375rem; }
  .tst__progress > span { height: 2px; overflow: hidden; border-radius: 2px; background: rgb(255 255 255 / 0.15); }
  .tst__progress > span > span { display: block; height: 100%; background: var(--color-accent); transform-origin: 0 50%; transform: scaleX(0); }
  @media (min-width: 1024px) {
    .tst { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 4rem; }
  }

  .t-nav {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 999px;
    cursor: pointer;
    transition: background-color 0.4s var(--ease-out-expo), border-color 0.4s;
  }
  .t-nav:hover { background: var(--color-accent); border-color: var(--color-accent); }
</style>

<script>
  import { gsap } from 'gsap';

  const root = document.querySelector<HTMLElement>('[data-testimonials]');
  if (root) {
    const n = Number(root.dataset.total);
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const segs = [...root.querySelectorAll<HTMLElement>('[data-seg]')];
    const current = root.querySelector<HTMLElement>('[data-current]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DURATION = 7;
    let i = 0;
    let timer: gsap.core.Tween | null = null;

    const show = (next: number) => {
      i = (next + n) % n;
      slides.forEach((s, j) => s.setAttribute('aria-hidden', String(j !== i)));
      segs.forEach((s, j) => gsap.set(s, { scaleX: j < i ? 1 : 0 }));
      current.textContent = String(i + 1).padStart(2, '0');
      if (!reduce) start();
    };
    // Timer = Fortschrittssegment; am Ende naechste Stimme.
    const start = () => {
      timer?.kill();
      timer = gsap.fromTo(segs[i], { scaleX: 0 }, { scaleX: 1, duration: DURATION, ease: 'none', onComplete: () => show(i + 1), paused: !running() });
    };
    let hovered = false;
    let visible = false;
    const running = () => visible && !hovered;
    const sync = () => (running() ? timer?.resume() : timer?.pause());

    root.querySelector('[data-prev]')!.addEventListener('click', () => show(i - 1));
    root.querySelector('[data-next]')!.addEventListener('click', () => show(i + 1));
    root.addEventListener('pointerenter', () => { hovered = true; sync(); });
    root.addEventListener('pointerleave', () => { hovered = false; sync(); });
    root.addEventListener('focusin', () => { hovered = true; sync(); });
    root.addEventListener('focusout', () => { hovered = false; sync(); });
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; sync(); }, { threshold: 0.4 }).observe(root);
    root.style.setProperty('--n', String(n));
    show(0);
  }
</script>
