---
// Warum wir: Desktop (mit JS, Bewegung erlaubt) als fixierte Buehne. Links die
// nummerierte Liste mit Fortschrittslinie, rechts eine Karte, die beim Scrollen
// wechselt. Ohne JS, mobil oder mit "Bewegung reduzieren": einfache Kartenliste.
import Img from '../ui/Img.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { img } from '../../config/firm';
import { useI18n } from '../../i18n';
const { f: firm, fill, rich, t, ui, locale } = useI18n(Astro.url);

const c = firm.warum;
const reasons = c.items.map((r) => ({ ...r, title: fill(r.title), text: fill(r.text), detail: fill(r.detail), image: img(r.image) }));
---
<section class="warum" data-warum style={`--n:${reasons.length}`}>
  <div class="warum__track" data-warum-track>
    <div class="warum__sticky container-site">
      <div class="warum__aside">
        <div>
          <Eyebrow>{c.eyebrow}</Eyebrow>
          <h2 class="t-h3 mt-3" data-split set:html={rich(c.heading)} />
        </div>
        <ol class="warum__nav" aria-label={t('reasons')}>
          {reasons.map((r, i) => (
            <li>
              <button type="button" class="warum-tab" data-tab={i} aria-current={i === 0 ? 'true' : 'false'}>
                <span class="warum-tab__idx">{String(i + 1).padStart(2, '0')}</span>
                <span class="warum-tab__title">{r.title}</span>
                <span class="warum-tab__bar" aria-hidden="true"><span data-bar></span></span>
              </button>
            </li>
          ))}
        </ol>
      </div>

      <div class="warum__stage">
        {reasons.map((r, i) => (
          <article class:list={['warum-panel', i === 0 && 'is-active']} data-panel={i}>
            <div class="warum-panel__media">
              <Img src={r.image} alt={r.alt} sizes="(min-width: 1024px) 50vw, 100vw" widths={[480, 800, 1200, 1600]} class="size-full object-cover" pictureClass="block size-full" />
            </div>
            <div class="warum-panel__body">
              <div>
                <h3 class="t-title">{r.title}</h3>
                <p class="warum-panel__text">{r.text}</p>
              </div>
              <dl class="warum-panel__detail">
                <dt>{c.detailLabel}</dt>
                <dd>{r.detail}</dd>
              </dl>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .warum { padding-block: 5.3125rem; }

  /* ---------- Grundlayout: Kartenliste (mobil, ohne JS, reduzierte Bewegung) ---------- */
  .warum__aside { margin-bottom: 2.5rem; }
  /* Zeilen fuellen statt ausbalancieren: "Was uns von der Kanzlei / nebenan trennt". */
  .warum__aside h2 { text-wrap: wrap; }
  .warum__nav { display: none; }
  .warum__stage { display: grid; gap: 1rem; }
  .warum-panel {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 0.625rem;
    border-radius: var(--radius-card);
    background: var(--color-paper);
  }
  .warum-panel__media { aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radius-sm); }
  .warum-panel__body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1rem 0.875rem 0.875rem;
  }
  .warum-panel__text { margin-top: 0.625rem; max-width: 34rem; line-height: 1.55; color: rgb(0 0 0 / 0.7); }
  .warum-panel__detail {
    display: grid;
    gap: 0.375rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(0 0 0 / 0.1);
  }
  .warum-panel__detail dt { font-size: 0.75rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent-ink); }
  .warum-panel__detail dd { line-height: 1.5; }
  /* Tablet: zwei Karten nebeneinander, flachere Bilder (statt vier bildschirmhoher Karten). */
  @media (min-width: 640px) {
    .warum__stage { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .warum-panel__media { aspect-ratio: 3 / 2; }
    .warum-panel__body { padding: 0.875rem 0.625rem 0.625rem; }
  }
  /* Desktop-Buehne: Detail zweispaltig neben der Bezeichnung. */
  .warum.is-pinned .warum-panel__detail { grid-template-columns: 10rem minmax(0, 1fr); gap: 1.5rem; }

  /* ---------- Buehne (Desktop, per JS aktiviert) ---------- */
  .warum.is-pinned { padding-block: 0; }
  .warum.is-pinned .warum__track { height: calc(100svh + (var(--n) - 1) * 70svh); }
  .warum.is-pinned .warum__sticky {
    position: sticky;
    top: 0;
    display: grid;
    grid-template-columns: minmax(0, 9fr) minmax(0, 11fr);
    gap: 4rem;
    align-items: center;
    height: 100svh;
  }
  .warum.is-pinned .warum__aside {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    height: var(--stage-h);
    margin: 0;
  }
  /* Ueberschrift darf in den Spaltenabstand laufen, damit sie zweizeilig bleibt;
     darunter reicht die Breite nicht: ausbalancieren statt "trennt" allein. */
  .warum.is-pinned .warum__aside h2 { text-wrap: balance; }
  @media (min-width: 1200px) {
    .warum.is-pinned .warum__aside h2 { margin-right: -3rem; text-wrap: wrap; }
  }
  .warum.is-pinned .warum__nav { display: block; }
  .warum.is-pinned .warum__stage {
    --stage-h: min(42rem, calc(100svh - 8rem));
    position: relative;
    display: block;
    height: var(--stage-h);
  }
  .warum.is-pinned .warum__sticky { --stage-h: min(42rem, calc(100svh - 8rem)); }
  .warum.is-pinned .warum-panel {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s var(--ease-out-expo), visibility 0.6s;
  }
  .warum.is-pinned .warum-panel.is-active { opacity: 1; visibility: visible; z-index: 1; }
  .warum.is-pinned .warum-panel__media { flex: 1; aspect-ratio: auto; min-height: 0; }
  .warum.is-pinned .warum-panel__media :global(img) { transform: scale(1.08); transition: transform 1.4s var(--ease-out-expo); }
  .warum.is-pinned .warum-panel.is-active .warum-panel__media :global(img) { transform: scale(1); }
  .warum.is-pinned .warum-panel__body { flex: none; padding: 1.25rem 1.25rem 1rem; }
  .warum.is-pinned .warum-panel__body > * { transform: translateY(1rem); opacity: 0; transition: transform 0.9s var(--ease-out-expo), opacity 0.6s; }
  .warum.is-pinned .warum-panel.is-active .warum-panel__body > * { transform: none; opacity: 1; transition-delay: 0.12s; }
  .warum.is-pinned .warum-panel.is-active .warum-panel__body > :last-child { transition-delay: 0.22s; }

  /* Navigation links */
  .warum-tab {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    align-items: baseline;
    width: 100%;
    padding: 1.25rem 0;
    border-bottom: 1px solid rgb(0 0 0 / 0.12);
    text-align: left;
    cursor: pointer;
  }
  .warum-tab__idx { font-size: 0.8125rem; letter-spacing: 0.06em; color: rgb(0 0 0 / 0.6); font-variant-numeric: tabular-nums; transition: color 0.4s; }
  .warum-tab__title {
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.025em;
    color: rgb(0 0 0 / 0.56);
    transition: color 0.4s, transform 0.7s var(--ease-out-expo);
  }
  /* Fortschritt laeuft direkt auf der Trennlinie der Zeile (keine zweite Linie). */
  .warum-tab__bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.4s;
  }
  .warum-tab__bar > span { display: block; height: 100%; background: var(--color-accent); transform-origin: 0 50%; transform: scaleX(0); }
  .warum-tab[aria-current='true'] .warum-tab__idx { color: var(--color-accent-ink); }
  .warum-tab[aria-current='true'] .warum-tab__title { color: var(--color-ink); }
  .warum-tab[aria-current='true'] .warum-tab__bar { opacity: 1; }
  @media (hover: hover) {
    .warum-tab:not([aria-current='true']):hover .warum-tab__title { color: rgb(0 0 0 / 0.6); transform: translateX(0.375rem); }
  }
  .warum-tab:focus { outline: none; }
  .warum-tab:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; border-radius: var(--radius-btn); }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector<HTMLElement>('[data-warum]');
  if (root && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const track = root.querySelector<HTMLElement>('[data-warum-track]')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const bars = tabs.map((t) => t.querySelector<HTMLElement>('[data-bar]')!);
    const n = panels.length;
    let current = -1;

    const setActive = (i: number) => {
      if (i === current) return;
      current = i;
      panels.forEach((p, j) => p.classList.toggle('is-active', j === i));
      tabs.forEach((t, j) => t.setAttribute('aria-current', String(j === i)));
    };

    gsap.matchMedia().add('(min-width: 1024px)', () => {
      root.classList.add('is-pinned');
      ScrollTrigger.refresh();
      const st = ScrollTrigger.create({
        trigger: track,
        start: 'top top',
        end: 'bottom bottom',
        onUpdate: (self) => {
          const v = self.progress * n;
          const i = Math.min(n - 1, Math.floor(v));
          setActive(i);
          bars.forEach((b, j) => gsap.set(b, { scaleX: j === i ? Math.min(1, v - i) : 0 }));
        },
      });
      setActive(0);

      const onClick = (e: Event) => {
        const i = Number((e.currentTarget as HTMLElement).dataset.tab);
        const y = st.start + ((st.end - st.start) * (i + 0.15)) / n;
        const lenis = (window as unknown as { lenis?: { scrollTo(y: number, o: object): void } }).lenis;
        if (lenis) lenis.scrollTo(y, { duration: 1.2 });
        else window.scrollTo({ top: y, behavior: 'smooth' });
      };
      tabs.forEach((t) => t.addEventListener('click', onClick));

      return () => {
        root.classList.remove('is-pinned');
        tabs.forEach((t) => t.removeEventListener('click', onClick));
        panels.forEach((p) => p.classList.remove('is-active'));
        current = -1;
      };
    });
  }
</script>
