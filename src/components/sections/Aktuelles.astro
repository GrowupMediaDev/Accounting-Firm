---
// Aktuelles (Figma 41:4595 + 41:4599): zentrierte Kopfzeile, zwei Artikelkarten,
// die in die folgende dunkle CTA-Sektion hineinragen.
import Img from '../ui/Img.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Arrow from '../ui/Arrow.astro';
import { SECTION } from '../../config/nav';
import { news } from '../../data/content';
---
<section id={SECTION.aktuelles} class="aktuelles">
  <div class="container-site">
    <header class="mx-auto flex max-w-[852px] flex-col items-center text-center">
      <Eyebrow>Aktuelles</Eyebrow>
      <h2 class="t-h2 mt-1.5" data-split>Steuerthemen, die für Ihr Unternehmen zählen</h2>
    </header>

    <div class="mt-[100px] grid gap-[30px] md:grid-cols-2">
      {news.map((n) => (
        <article class="news-card has-arrow" data-reveal="up">
          <div class="news-card__media">
            <Img src={n.image} alt={n.alt} sizes="(min-width: 768px) 50vw, 100vw" widths={[480, 800, 1300]} class="size-full object-cover" pictureClass="block size-full" />
            <span class="news-card__badge" aria-hidden="true"><Arrow /></span>
          </div>
          <div class="p-6">
            <h3 class="font-display text-[clamp(1.5rem,1.2rem+1vw,2rem)] leading-tight text-black">{n.title}</h3>
            <p class="mt-3.5 leading-6 tracking-[-0.02em] text-black/80">{n.text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .aktuelles {
    position: relative;
    z-index: 2;
    padding-top: 78px;
  }
  .news-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 8px;
    border-radius: 32px;
    background: var(--color-paper);
    transition: transform 0.8s var(--ease-out-expo);
  }
  .news-card__media {
    position: relative;
    height: clamp(260px, 33vw, 480px);
    overflow: hidden;
    border-radius: 24px;
  }
  .news-card__media :global(img) { transition: transform 1.4s var(--ease-out-expo); }
  .news-card__badge {
    position: absolute;
    top: 10px;
    right: 10px;
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: 70px;
    background: var(--color-accent);
    transform: scale(0) rotate(-45deg);
    transition: transform 0.7s var(--ease-out-expo);
  }
  @media (hover: hover) {
    .news-card:hover { transform: translateY(-6px); }
    .news-card:hover .news-card__media :global(img) { transform: scale(1.06); }
    .news-card:hover .news-card__badge { transform: scale(1) rotate(0); }
  }
  @media (hover: none) {
    .news-card__badge { transform: none; }
  }
</style>
