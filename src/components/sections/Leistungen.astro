---
// Unsere Leistungen als Index-Liste ("Kontenrahmen"): grosse Titel in Zeilen,
// auf Desktop folgt ein Vorschaubild dem Cursor, Klick oeffnet die Details.
// Mobil: Antippen oeffnet die Zeile mit Bild.
import Img from '../ui/Img.astro';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { SECTION } from '../../config/nav';
import Check from '../../assets/icons/double-check.svg';
import { img } from '../../config/firm';
import { useI18n } from '../../i18n';
const { f: firm, fill, rich, t, ui, locale } = useI18n(Astro.url);

const c = firm.leistungen;
const services = c.items.map((s) => ({ ...s, title: fill(s.title), text: fill(s.text), points: s.points.map(fill), image: img(s.image) }));
---
<section id={SECTION.leistungen} class="leistungen">
  <div class="container-site">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-12">
      <div>
        <Eyebrow>{c.eyebrow}</Eyebrow>
        <h2 class="t-h2 mt-1.5 max-w-[53.25rem]" data-split set:html={rich(c.heading)} />
      </div>
      <p class="max-w-[25.625rem] pb-1.5 text-black/80 lg:text-right" data-reveal="up">{fill(c.lead)}</p>
    </div>

    <div class="svc" data-svc>
      <ul class="svc__list">
        {services.map((s, i) => (
          <li class="svc__item" data-svc-item={i}>
            <h3>
              <button type="button" class="svc__row" aria-expanded="false" aria-controls={`svc-panel-${i}`} id={`svc-row-${i}`} data-svc-row>
                <span class="svc__idx">{String(i + 1).padStart(2, '0')}</span>
                <span class="svc__title">{s.title}</span>
                <span class="svc__tags">{s.points.join(' · ')}</span>
                <span class="svc__toggle" aria-hidden="true"><span></span><span></span></span>
              </button>
            </h3>
            <div class="svc__panel" id={`svc-panel-${i}`} role="region" aria-labelledby={`svc-row-${i}`}>
              <div class="svc__panel-inner">
                <div class="svc__body">
                  <p class="svc__text">{s.text}</p>
                  <div>
                    <p class="svc__label">{c.scopeLabel}</p>
                    <ul class="svc__points">
                      {s.points.map((p) => (
                        <li><Check width="1.125rem" height="1.125rem" class="shrink-0 text-accent" aria-hidden="true" />{p}</li>
                      ))}
                    </ul>
                  </div>
                  <Button href={`#${SECTION.termin}`} variant="accent" class="self-start" tabindex={-1} data-svc-cta>{c.cta}</Button>
                </div>
                <div class="svc__media">
                  <Img src={s.image} alt={s.alt} sizes="(min-width: 1024px) 34vw, 100vw" widths={[480, 800, 1200]} class="size-full object-cover" pictureClass="block size-full" />
                </div>
              </div>
            </div>
          </li>
        ))}
      </ul>

      <!-- Vorschau, folgt dem Cursor (nur Desktop mit Maus) -->
      <!-- Aussen: Position/Neigung per GSAP. Innen: Ein-/Ausblenden per CSS (getrennt, sonst Konflikt der Transforms). -->
      <div class="svc__preview" data-svc-preview aria-hidden="true">
        <div class="svc__preview-frame">
          {services.map((s, i) => (
            <div class="svc__preview-img" data-svc-img={i}>
              <Img src={s.image} alt="" sizes="17rem" widths={[340, 680]} class="size-full object-cover" pictureClass="block size-full" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .leistungen { padding: 15.625rem 0 7.5rem; }
  @media (max-width: 1023px) {
    .leistungen { padding-top: 13rem; }
  }

  .svc { position: relative; margin-top: 4.5rem; }
  .svc__list { border-top: 1px solid rgb(0 0 0 / 0.14); }
  .svc__item { border-bottom: 1px solid rgb(0 0 0 / 0.14); }

  .svc__row {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 1.75rem 0;
    text-align: left;
    cursor: pointer;
  }
  .svc__idx {
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    color: rgb(0 0 0 / 0.6);
    font-variant-numeric: tabular-nums;
    transition: color 0.4s;
  }
  /* Sans statt Serif: die Serif bleibt den Ueberschriften vorbehalten. */
  .svc__title {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(1.625rem, 1.15rem + 1.8vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
    transition: transform 0.8s var(--ease-out-expo), color 0.4s;
  }
  .svc__tags { display: none; font-size: 0.875rem; color: rgb(0 0 0 / 0.55); text-align: right; }
  /* Offen: Tags doppeln die Liste darunter -> ausblenden. */
  .svc__tags { transition: opacity 0.4s; }
  .svc__item.is-open .svc__tags { opacity: 0; }
  .svc__toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid rgb(0 0 0 / 0.2);
    transition: background-color 0.4s, border-color 0.4s, transform 0.6s var(--ease-out-expo);
  }
  .svc__toggle span {
    position: absolute;
    width: 0.875rem;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.6s var(--ease-out-expo);
  }
  .svc__toggle span:last-child { transform: rotate(90deg); }

  /* Hover / offen */
  @media (hover: hover) {
    .svc__item:not(.is-open) .svc__row:hover .svc__title { transform: translateX(1.25rem); }
    .svc__row:hover .svc__idx { color: var(--color-accent-ink); }
    .svc__row:hover .svc__toggle { background: var(--color-ink); border-color: var(--color-ink); color: var(--color-paper); }
  }
  .svc__item.is-open .svc__idx { color: var(--color-accent-ink); }
  .svc__item.is-open .svc__toggle { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-paper); transform: rotate(180deg); }
  .svc__item.is-open .svc__toggle span:last-child { transform: rotate(0deg); }

  .svc__row:focus { outline: none; }
  .svc__row:focus-visible { outline: 2px solid var(--color-accent); outline-offset: -2px; border-radius: var(--radius-btn); }

  /* Panel */
  .svc__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.8s var(--ease-out-expo);
  }
  .svc__item.is-open .svc__panel { grid-template-rows: 1fr; }
  .svc__panel-inner { overflow: hidden; display: grid; gap: 1.5rem; }
  .svc__body { display: flex; flex-direction: column; align-items: flex-start; gap: 2rem; padding-bottom: 0.5rem; }
  .svc__text { max-width: 30rem; font-size: 1.1875rem; line-height: 1.5; letter-spacing: -0.01em; color: var(--color-ink); }
  .svc__label { font-size: 0.75rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: rgb(0 0 0 / 0.5); }
  .svc__points { width: min(100%, 26rem); margin-top: 0.75rem; border-top: 1px solid rgb(0 0 0 / 0.12); }
  .svc__points li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.8125rem 0;
    border-bottom: 1px solid rgb(0 0 0 / 0.12);
    font-size: 0.9375rem;
  }
  .svc__media { aspect-ratio: 16 / 10; overflow: hidden; border-radius: var(--radius-card); margin-bottom: 1.75rem; }
  .svc__body, .svc__media {
    opacity: 0;
    transform: translateY(1rem);
    transition: opacity 0.5s, transform 0.8s var(--ease-out-expo);
  }
  .svc__item.is-open .svc__body, .svc__item.is-open .svc__media { opacity: 1; transform: none; transition-delay: 0.15s; }

  @media (min-width: 1024px) {
    .svc__row { grid-template-columns: 4rem minmax(0, 1fr) minmax(0, 26rem) auto; gap: 2rem; padding: 1.75rem 0; }
    .svc__tags { display: block; }
    .svc__panel-inner { grid-template-columns: 4rem minmax(0, 1fr) minmax(0, 1fr); column-gap: 2rem; }
    .svc__body { grid-column: 2; align-self: start; padding: 0.25rem 0 2.5rem; }
    .svc__media { grid-column: 3; margin-bottom: 2.5rem; }
  }

  /* Cursor-Vorschau */
  .svc__preview {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 5;
    width: 17rem;
    aspect-ratio: 16 / 11;
    pointer-events: none;
    will-change: transform;
  }
  .svc__preview-frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: var(--radius-card);
    box-shadow: 0 2rem 3rem -1.5rem rgb(0 0 0 / 0.4);
    opacity: 0;
    transform: scale(0.6);
    transition: opacity 0.35s, transform 0.6s var(--ease-out-expo);
  }
  .svc__preview.is-visible .svc__preview-frame { opacity: 1; transform: scale(1); }
  .svc__preview-img {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.15);
    transition: opacity 0.45s, transform 0.9s var(--ease-out-expo);
  }
  .svc__preview-img.is-active { opacity: 1; transform: scale(1); }
  @media (hover: none), (max-width: 1023px) {
    .svc__preview { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .svc__panel, .svc__body, .svc__media, .svc__title, .svc__preview-frame, .svc__preview-img { transition: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const root = document.querySelector<HTMLElement>('[data-svc]');
  if (root) {
    const items = [...root.querySelectorAll<HTMLElement>('[data-svc-item]')];

    // ---------- Akkordeon (eine Zeile offen) ----------
    const setOpen = (item: HTMLElement, open: boolean) => {
      item.classList.toggle('is-open', open);
      item.querySelector('[data-svc-row]')!.setAttribute('aria-expanded', String(open));
      item.querySelector<HTMLElement>('[data-svc-cta]')!.tabIndex = open ? 0 : -1;
    };
    items.forEach((item) => {
      item.querySelector('[data-svc-row]')!.addEventListener('click', () => {
        const open = !item.classList.contains('is-open');
        items.forEach((other) => setOpen(other, false));
        setOpen(item, open);
        if (open) preview.classList.remove('is-visible');
      });
    });

    // ---------- Cursor-Vorschau (Desktop mit Maus) ----------
    const preview = root.querySelector<HTMLElement>('[data-svc-preview]')!;
    const imgs = [...root.querySelectorAll<HTMLElement>('[data-svc-img]')];
    const fine = matchMedia('(hover: hover) and (pointer: fine) and (min-width: 1024px)');
    if (fine.matches) {
      const xTo = gsap.quickTo(preview, 'x', { duration: 0.6, ease: 'power3.out' });
      const yTo = gsap.quickTo(preview, 'y', { duration: 0.6, ease: 'power3.out' });
      const rTo = gsap.quickTo(preview, 'rotation', { duration: 0.8, ease: 'power3.out' });
      let lastX = 0;
      const move = (e: PointerEvent) => {
        const r = root.getBoundingClientRect();
        const x = e.clientX - r.left;
        const y = e.clientY - r.top;
        // Bild rechts neben dem Cursor, leicht nach oben versetzt.
        xTo(x + 32);
        yTo(y - preview.offsetHeight * 0.55);
        rTo(Math.max(-8, Math.min(8, (e.clientX - lastX) * 0.5)));
        lastX = e.clientX;
      };
      items.forEach((item, i) => {
        const row = item.querySelector<HTMLElement>('[data-svc-row]')!;
        row.addEventListener('pointerenter', (e) => {
          if (item.classList.contains('is-open')) return;
          imgs.forEach((im, j) => im.classList.toggle('is-active', j === i));
          const r = root.getBoundingClientRect();
          gsap.set(preview, { x: e.clientX - r.left + 32, y: e.clientY - r.top - preview.offsetHeight * 0.55 });
          lastX = e.clientX;
          preview.classList.add('is-visible');
        });
        row.addEventListener('pointerleave', () => preview.classList.remove('is-visible'));
        row.addEventListener('pointermove', move);
      });
    }
  }
</script>
