---
// CTA "Gute Beratung beginnt mit einem Gespraech" (Figma 41:4724): schwarze Buehne mit runder
// Oberkante. Die zwei Haende fahren beim Scrollen aufeinander zu und
// uebergeben die Unterlagen. Hintergrund: oben schwarz, ab der Mitte der Haende
// das animierte Muster aus dem Profil (WebGL, src/scripts/chevron-shader.ts), das
// zur Footer-Kante in Schwarz auslaeuft; der Footer bleibt einfarbig. Ziel aller "Erstgespraech"-Buttons der Seite.
import Img from '../ui/Img.astro';
import Button from '../ui/Button.astro';
import { SECTION } from '../../config/nav';
import { nap, telHref } from '../../config/site';
import { img } from '../../config/firm';
import { useI18n } from '../../i18n';
const { f: firm, fill, rich, t, ui, locale } = useI18n(Astro.url);
import { pattern } from '../../config/pattern';

const c = firm.cta;
// Vorbefuellte Mail: Interessenten muessen nur noch die Luecken fuellen.
const mail = `mailto:${nap.email}?subject=${encodeURIComponent(fill(c.mailSubject))}&body=${encodeURIComponent(fill(c.mailBody))}`;
---
<section id={SECTION.termin} class="wechsel" data-wechsel>
  {pattern.type !== 'none' && (
    <canvas class="wechsel__shader" data-shader data-pattern={pattern.index} data-intensity={pattern.intensity} data-color={pattern.rgb} data-bg={pattern.bg} style={`--pattern-svg:${pattern.svg}`} aria-hidden="true"></canvas>
  )}

  <div class="wechsel__hands" aria-hidden="true">
    <div class="wechsel__hand" data-hand="giving">
      <Img src={img(c.handGiving)} alt="" sizes="100vw" widths={[800, 1440, 2000, 2444]} class="size-full object-cover" pictureClass="block size-full" />
    </div>
    <div class="wechsel__hand" data-hand="receiving">
      <Img src={img(c.handReceiving)} alt="" sizes="100vw" widths={[800, 1440, 2000, 2444]} class="size-full object-cover" pictureClass="block size-full" />
    </div>
  </div>

  <div class="wechsel__content container-site relative flex flex-col items-center text-center">
    <h2 class="max-w-[53.875rem] font-display text-[clamp(3rem,1.6rem+5.6vw,6.5rem)] leading-[0.98] text-balance text-white" data-split set:html={rich(c.heading)} />
    <p class="mt-6 max-w-[34.875rem] text-[clamp(1.125rem,1rem+0.4vw,1.35rem)] leading-[1.63] text-white/80" data-reveal="up">
      {fill(c.text)}
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-2.5" data-reveal="up">
      <Button href={mail} variant="accent">{c.button}</Button>
      <Button href={telHref} variant="light" aria-label={`${t('call')}: ${nap.phone}`}>{nap.phone}</Button>
    </div>
    <ul class="wechsel__facts" data-reveal="up">
      {c.facts.map((f) => <li>{fill(f)}</li>)}
    </ul>
  </div>
</section>

<style>
  .wechsel {
    --eyebrow-color: var(--color-accent);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    /* Ueberlappung: die Aktuelles-Karten ragen tief herein (Figma). */
    margin-top: -12.5rem;
    padding: 15rem 0 7.5rem;
    border-radius: var(--radius-section) var(--radius-section) 0 0;
    background: var(--color-ink);
  }
  @media (min-width: 1024px) {
    .wechsel { margin-top: -21.875rem; padding-top: 31.25rem; }
  }

  /* Shader ab der Mitte der Haende bis zur Footer-Kante. Lage und Hoehe setzt
     chevron-shader.ts pixelgenau; die Werte hier gelten nur ohne WebGL. */
  .wechsel__shader {
    position: absolute;
    left: 0;
    top: 30%;
    z-index: -2;
    width: 100%;
    height: 70%;
  }
  /* Ohne WebGL: dasselbe Muster statisch (SVG aus config/pattern.ts), nach oben ausgeblendet. */
  .wechsel__shader:global(.no-gl) {
    background-image: var(--pattern-svg);
    -webkit-mask-image: linear-gradient(180deg, transparent, #000);
    mask-image: linear-gradient(180deg, transparent, #000);
  }

  .wechsel__hands {
    position: relative;
    display: grid;
    width: 100%;
    aspect-ratio: 2444 / 1100;
    margin-bottom: clamp(-7.5rem, -6vw, -2.5rem);
  }
  .wechsel__hand { grid-area: 1 / 1; will-change: transform; }

  /* Vertrauens-Zeile unter den Kontaktwegen */
  .wechsel__facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    margin-top: 1.75rem;
    font-size: 0.9375rem;
    color: rgb(255 255 255 / 0.66);
  }
  .wechsel__facts li { display: flex; align-items: center; gap: 0.5rem; }
  .wechsel__facts li::before {
    content: '';
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--color-accent);
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { initChevronField } from '../../scripts/chevron-shader';
  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector<HTMLElement>('[data-wechsel]');
  if (root) {
    // Muster ab der Mitte der Haende, laeuft zur Footer-Kante in Schwarz aus.
    const canvas = root.querySelector<HTMLCanvasElement>('[data-shader]');
    const hands = root.querySelector<HTMLElement>('.wechsel__hands');
    if (canvas && hands) {
      initChevronField(canvas, () => {
        const h = hands.getBoundingClientRect();
        const r = root.getBoundingClientRect();
        return { from: h.top + h.height * 0.5 + scrollY, to: r.bottom + scrollY };
      });
    }

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const giving = root.querySelector('[data-hand="giving"]');
      const receiving = root.querySelector('[data-hand="receiving"]');
      // Laengerer Scroll-Weg, damit man die Uebergabe miterlebt. Mobil sind die
      // Haende flach (~175px), dort laeuft es von Eintritt bis ins obere Viertel.
      gsap.matchMedia().add({ mobile: '(max-width: 767px)', desktop: '(min-width: 768px)' }, (ctx) => {
        const { mobile } = ctx.conditions as { mobile: boolean };
        const st = mobile
          ? { trigger: hands, start: 'top bottom', end: 'bottom 25%', scrub: 1.2 }
          : { trigger: hands, start: 'top 90%', end: 'center 35%', scrub: 1.2 };
        gsap.fromTo(giving, { xPercent: -28, rotate: -4 }, { xPercent: 0, rotate: 0, ease: 'none', scrollTrigger: st });
        gsap.fromTo(receiving, { xPercent: 26, rotate: 5 }, { xPercent: 0, rotate: 0, ease: 'none', scrollTrigger: st });
      });
    }
  }
</script>
