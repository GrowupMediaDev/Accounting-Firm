---
// Startseite: One-Pager aus Figma "Accountant".
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Kanzlei from '../components/sections/Kanzlei.astro';
import Leistungen from '../components/sections/Leistungen.astro';
import Ansatz from '../components/sections/Ansatz.astro';
import WarumWir from '../components/sections/WarumWir.astro';
import Team from '../components/sections/Team.astro';
import Faq from '../components/sections/Faq.astro';
import Aktuelles from '../components/sections/Aktuelles.astro';
import Wechsel from '../components/sections/Wechsel.astro';
import { faqs } from '../data/content';

const title = 'Steuerberater Düsseldorf – Hartmann & Vogt Steuerberatung';
const description = 'Digitale Steuerberatung für Mittelstand und Selbstständige in Düsseldorf: fester Ansprechpartner, festes Monatshonorar, Antwort innerhalb von 24 Stunden.';
---
<Layout pageKey="home" locale="de" title={title} description={description}>
  <Schema slot="head" pageKey="home" locale="de" faq={faqs} />
  <Header />
  <main>
    <Hero />
    <Kanzlei />
    <Leistungen />
    <Ansatz />
    <WarumWir />
    <Team />
    <Faq />
    <Aktuelles />
    <Wechsel />
  </main>
  <Footer />
</Layout>
