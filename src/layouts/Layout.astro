---
// Basis-Layout: nur Kopf-Plumbing (Canonical, hreflang, OG, Twitter) + <slot/>.
// KEIN festes Design, kein Header/Footer erzwungen. Das kommt pro Projekt.
import { site, previewMode } from '../config/site';
import { routes, localizedPath, hasEN, type PageKey } from '../config/routes';
import type { Locale } from '../config/site';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource-variable/instrument-sans';
import '@fontsource/gelasio/400.css';
import '../styles/fonts-gambarino.css';
import '../styles/global.css';
import { firm } from '../config/firm';
import { themeCss, themeColors } from '../config/theme';
import gambarinoUrl from '../assets/fonts/Gambarino-Regular.woff2?url';
// Display- und Textschrift vorladen: verhindert Layout-Spruenge beim Schriftwechsel (CLS).
import serifUrl from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import serifItalicUrl from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import sansUrl from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';

interface Props {
  pageKey: PageKey;
  locale: Locale;
  title: string;
  description: string;
  ogImage?: string;
  /** Hero mit Vollflaechen-Foto: Header startet mit heller Schrift. */
  heroPhoto?: boolean;
}

const { pageKey, locale, title, description, ogImage, heroPhoto = false } = Astro.props;
// Display-Schrift aus dem Profil: nur die gewaehlte wird vorgeladen.
const font = firm.theme.displayFont === 'gambarino' ? 'gambarino' : 'instrument-serif';
const route = routes[pageKey];

const canonical = new URL(localizedPath(pageKey, locale), site.url).href;
const deHref = new URL(localizedPath(pageKey, 'de'), site.url).href;
const enHref = hasEN(pageKey) ? new URL(localizedPath(pageKey, 'en'), site.url).href : null;
const ogImg = new URL(ogImage ?? site.ogImage, site.url).href;

// hreflang nur, wenn EN existiert UND die Seite indexierbar ist.
// Vorschau-Build (NOINDEX=1): nichts indexieren, kein Canonical/hreflang.
const indexable = route.indexable && !previewMode;
const showHreflang = hasEN(pageKey) && indexable;
---
<!doctype html>
<html lang={locale} data-font={font} data-hero={heroPhoto ? 'photo' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={themeColors.sky} />
    {font === 'gambarino'
      ? <link rel="preload" href={gambarinoUrl} as="font" type="font/woff2" crossorigin />
      : [<link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />,
         <link rel="preload" href={serifItalicUrl} as="font" type="font/woff2" crossorigin />]}
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
    <!-- TODO Favicon: ueber realfavicongenerator.net erzeugen. Bis dahin leeres Icon gegen den 404. -->
    <link rel="icon" href="data:," />
    <script is:inline>
      // Motion-Startzustaende nur mit JS. Faellt das Modul aus, nach 2,5 s alles zeigen.
      document.documentElement.classList.add('js');
      // Preloader nur beim ersten Seitenaufruf der Sitzung und nie bei Direktlinks
      // auf eine Sektion (z. B. #termin aus einer Mail): dort zaehlt der Inhalt.
      // ?intro erzwingt ihn zum Ansehen/Testen (z. B. localhost:4380/?intro).
      try {
        if (/[?&]intro\b/.test(location.search)) sessionStorage.removeItem('hv-seen');
        else if (location.hash || sessionStorage.getItem('hv-seen')) document.documentElement.classList.add('hv-seen');
      } catch (e) {}
      setTimeout(function () { if (!window.__motion) document.documentElement.classList.remove('js'); }, 2500);
    </script>
    <!-- Farbschema aus dem Kanzlei-Profil -->
    <style set:html={themeCss}></style>
    <title>{title}</title>
    <meta name="description" content={description} />

    {indexable
      ? <link rel="canonical" href={canonical} />
      : <meta name="robots" content={previewMode ? 'noindex, nofollow' : 'noindex, follow'} />}

    {showHreflang && [
      <link rel="alternate" hreflang="de" href={deHref} />,
      enHref && <link rel="alternate" hreflang="en" href={enHref} />,
      <link rel="alternate" hreflang="x-default" href={deHref} />,
    ]}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImg} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImg} />

    <slot name="head" />
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
