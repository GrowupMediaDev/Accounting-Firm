# Nur Namen, keine Werte. Echte Werte in die Cloudflare-Env-Einstellungen.
# Secrets NIE in diese Datei oder ins Repo.

# Site
PUBLIC_SITE_URL=

# Tracking (optional). GTM-Container wird oft erst nach Fertigstellung erstellt,
# dann hier bzw. in der Cloudflare-Env setzen und neu deployen. Leer = kein GTM.
PUBLIC_GTM_ID=

# Formulare (siehe FORMS.md)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
